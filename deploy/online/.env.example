MK_ONLINE_DOMAIN=online.robsonchristie.com
MK_PERSONAL_DOMAIN=robsonchristie.com
MK_PERSONAL_WWW_DOMAIN=www.robsonchristie.com
MK_SITE_DOMAIN=minkowskikart.robsonchristie.com
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Online protocol version the clients are built with. Must match the
# <server-version> in data/stk_config.xml and official_server_config.xml. Bump
# all of them together when the protocol changes, or clients cannot host games.
MK_ALLOWED_GAME_VERSION=7
MK_OFFICIAL_USERNAME=official-host
MK_OFFICIAL_PASSWORD=replace-with-the-invited-account-password
MK_OFFICIAL_TRACK=mobius_track
MK_OFFICIAL_BOTS=3
MK_OFFICIAL_MIN_PLAYERS=1
