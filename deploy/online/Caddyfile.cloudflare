# Caddyfile variant for running the static websites BEHIND Cloudflare.
#
# Use this instead of ./Caddyfile when robsonchristie.com / www /
# minkowskikart are proxied by Cloudflare (orange cloud). Cloudflare
# terminates TLS at its edge and connects back to this origin over HTTPS
# using a Cloudflare *Origin Certificate* (SSL/TLS mode: Full (strict)).
#
# IMPORTANT — keep these DNS records "DNS only" (grey cloud) in Cloudflare so
# the game is untouched and keeps publicly-trusted Let's Encrypt certs / direct
# UDP:
#   - online.robsonchristie.com   (matchmaking API, HTTPS)  -> stays automatic LE below
#   - play.robsonchristie.com     (gameplay, UDP 2759)      -> not served by Caddy at all
#
# See CLOUDFLARE.md for the full migration runbook.

{
    # The proxied sites below manually load the wildcard Cloudflare Origin
    # cert (*.robsonchristie.com). Without this, Caddy would also serve that
    # wildcard for online.robsonchristie.com, which is DNS-only and needs a
    # publicly trusted Let's Encrypt cert for the (non-browser) game client.
    # ignore_loaded_certs makes Caddy still manage + serve LE for online.
    auto_https ignore_loaded_certs
}

# Matchmaking API — DNS-only / direct, so it must present a real publicly
# trusted certificate to the (non-browser) game client. Force ACME/Let's
# Encrypt so Caddy doesn't fall back to the wildcard Cloudflare Origin cert
# loaded below (which only Cloudflare trusts). Requires this host to be
# DNS-only in Cloudflare so the ACME challenge reaches Caddy directly.
{$MK_ONLINE_DOMAIN} {
    encode zstd gzip
    tls {
        issuer acme
    }
    reverse_proxy api:8000
}

# Personal homepage — proxied by Cloudflare. Serve the Cloudflare Origin
# Certificate (only trusted by Cloudflare, which is the only thing that talks
# to this origin once the record is orange-clouded).
{$MK_PERSONAL_DOMAIN}, {$MK_PERSONAL_WWW_DOMAIN} {
    encode zstd gzip
    tls /certs/cf-origin.pem /certs/cf-origin.key
    root * /srv/robsonchristie
    # Always revalidate HTML so paper updates show up immediately.
    # Caddy still sends an ETag, so unchanged pages return a cheap 304.
    @html path / /*.html
    header @html Cache-Control "no-cache"
    file_server
}

# Game website — also proxied by Cloudflare.
{$MK_SITE_DOMAIN} {
    encode zstd gzip
    tls /certs/cf-origin.pem /certs/cf-origin.key
    root * /srv/minkowskikart
    file_server
}
