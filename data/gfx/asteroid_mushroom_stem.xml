<?xml version="1.0"?>
<!-- Mushroom-cloud stem: a narrow column of dark smoke rising from the impact
     point, feeding the cap above it. Tall, slow and long-lived so the column
     persists while the cap billows out. -->
<particles emitter="box" box_x="0.7" box_y="0.5" box_z="0.7">

    <spreading angle="14"          />

    <velocity  x="0.000"
               y="0.0055"
               z="0.000"           />

    <material  file="smoke.png"    />

    <rate      min="120"
               max="180"           />

    <lifetime  min="900"
               max="1500"          />

    <size      min="0.80"
               max="1.60"
               x-increase-factor="2.0"
               y-increase-factor="2.0" />

    <color     min="70 56 46"
               max="130 108 92"    />

</particles>
