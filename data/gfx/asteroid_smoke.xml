<?xml version="1.0"?>
<!-- Dark ablation smoke trailing behind the asteroid's plasma core. Slower,
     longer-lived and growing, so it lingers and billows out after the bright
     plasma in front of it has already faded - the sooty wake of a re-entry
     fireball. -->
<particles emitter="point">

    <spreading angle="48"          />

    <velocity  x="0.000"
               y="0.0020"
               z="0.000"           />

    <material  file="smoke.png"    />

    <rate      min="80"
               max="130"           />

    <lifetime  min="700"
               max="1200"          />

    <size      min="0.50"
               max="1.00"
               x-increase-factor="2.4"
               y-increase-factor="2.4" />

    <!-- Sooty brown-grey, darker than the plasma it trails. -->
    <color     min="60 38 30"
               max="130 90 72"     />

</particles>
