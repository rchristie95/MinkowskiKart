<?xml version="1.0" encoding="UTF-8"?>
<stkgui>
    <icon-button id="back" x="1%" y="0" height="9%" icon="gui/icons/back.png"/>
    <div x="1%" y="1%" width="98%" height="98%" layout="vertical-row" >
        <header width="80%" height="8%" align="center" text="SuperTuxKart Help" text_align="center"/>
        <spacer height="1%" width="100%"/>

        <div width="100%" height="91%" layout="horizontal-row" >

            <vertical-tabs id="category" height="100%" width="20%">
                <icon-button id="page1" width="128" height="128" icon="gui/icons/options_general.png"
                        I18N="Tab in help menu" text="General"/>
                <icon-button id="page2" width="128" height="128" icon="gui/icons/mode_ftl.png"
                        I18N="Tab in help menu" text="Game Modes"/>
                <icon-button id="page3" width="128" height="128" icon="gui/icons/gift.png"
                        I18N="Tab in help menu" text="Powerups"/>
                <icon-button id="page4" width="128" height="128" icon="gui/icons/compactification-icon.png"
                        I18N="Tab in help menu" text="Compactifications"/>
                <icon-button id="page5" width="128" height="128" icon="gui/icons/story_mode_book.png"
                        I18N="Tab in help menu" text="Story Mode"/>
                <icon-button id="page6" width="128" height="128" icon="gui/icons/mass.png"
                        I18N="Tab in help menu" text="Kart classes"/>
                <icon-button id="page7" width="128" height="128" icon="gui/icons/options_input.png"
                        I18N="Tab in help menu" text="Multiplayer"/>
            </vertical-tabs>

            <spacer width="2%" height="100%"/>

            <box width="78%" height="100%" layout="vertical-row">
                <spacer height="1%" width="10"/>
                <label align="center" word_wrap="true" I18N="In the help menu" text="To help you win, there are some powerups you can collect:"/>
                <spacer height="2%" width="10"/>

                <div width="100%" proportion="1" layout="horizontal-row">
                    <icon align="center" width="8%" height="100%" icon="gui/icons/warp-bubble-icon.png"/>
                    <spacer width="3%" height="100%"/>
                    <bubble proportion="1" height="100%" text="Warp Bubble: Wrap your kart in a local spacetime bubble. Blocks one incoming hit, clears attached hazards, and ignores sticky track traps."/>
                </div>

                <div width="100%" proportion="1" layout="horizontal-row">
                     <icon align="center" width="8%" height="100%" icon="gui/icons/zipper_collect.png"/>
                     <spacer width="3%" height="100%"/>
                     <bubble proportion="1" height="100%" text="Zipper - will give you a strong speed boost. But beware of not losing control of your kart!"/>
                </div>

                <div width="100%" proportion="1" layout="horizontal-row">
                    <icon align="center" width="8%" height="100%" icon="gui/icons/wormhole-icon.png"/>
                    <spacer width="3%" height="100%"/>
                    <bubble proportion="1" height="100%"
                            text="Wormhole: Spawn two linked portals. One opens ahead of you and the other opens farther up the track so any kart can cut through spacetime in either direction."/>
                </div>

                <div width="100%" proportion="1" layout="horizontal-row">
                    <icon align="center" width="8%" height="100%" icon="gui/icons/photon-icon.png"/>
                    <spacer width="3%" height="100%"/>
                    <bubble proportion="1" height="100%" text="Photon: Fire an exchanged particle on a moving blue light-wave. Hook racers or walls ahead, or hit a racer behind you with a relativistic Doppler flare."/>
                </div>

                <div width="100%" proportion="1" layout="horizontal-row">
                    <icon align="center" width="8%" height="100%" icon="gui/icons/black-hole-icon.png"/>
                    <spacer width="3%" height="100%"/>
                    <bubble proportion="1" height="100%"
                            text="Pocket Black Hole: Throw a tiny unstable singularity that curves out and back. Great if you aim it well. Terrible if you do not."/>
                </div>

                <div width="100%" proportion="1" layout="horizontal-row">
                    <icon align="center" width="8%" height="100%" icon="gui/icons/time-dilation-icon.png"/>
                    <spacer width="3%" height="100%"/>
        <bubble proportion="1" height="100%" text="Time-Dilation Field: Trap every other racer in a relativistic slowdown zone. Their speed and acceleration drop while the world smears around them."/>
                </div>

                <div width="100%" proportion="1" layout="horizontal-row">
                    <icon align="center" width="8%" height="100%" icon="gui/icons/swap-icon.png"/>
                    <spacer width="3%" height="100%"/>
                    <bubble proportion="1" height="100%" text="Super Position: Compactifications and item boxes collapse into a shared pickup. Touch one to get either a random powerup or an immediate Compactification hit."/>
                </div>

                <div width="100%" proportion="1" layout="horizontal-row">
                     <icon align="center" width="8%" height="100%" icon="gui/icons/asteroid-icon.png"/>
                     <spacer width="3%" height="100%"/>
                     <bubble proportion="1" height="100%" text="Asteroid: Launch a dense rocky projectile that slams racers and bleeds off their momentum on impact."/>
                </div>

                <div width="100%" proportion="1" layout="horizontal-row">
                     <icon align="center" width="8%" height="100%" icon="gui/icons/anti-karticle-icon.png"/>
                     <spacer width="3%" height="100%"/>
                     <bubble proportion="1" height="100%" text="Anti-Karticle: Create an inverted clone that mirrors your motion backward and knocks racers aside."/>
                </div>

            </box>
        </div>
    </div>
</stkgui>
