<?xml version="1.0"?>
<powerup>
  <!-- Minkowski Kart - Relativistic Powerups
       Order must match PowerupType enum in powerup_manager.hpp:
       warp-bubble, asteroid, black-hole, zipper, photon,
       super_position, anti-karticle, wormhole, time-dilation, maxwell-boltzmann -->

  <!-- WARP BUBBLE: shield sphere (was bubblegum) -->
  <item name="warp-bubble"     icon="warp-bubble-icon.png" />

  <!-- ASTEROID: fast dense lobbed projectile -->
  <item name="asteroid"        icon="asteroid-icon.png"
        model="asteroid-meshy.spm" speed="50"
        min-height="0.2"       max-height="1.0"
        force-updown="25"      max-distance="90" />

  <!-- POCKET BLACK HOLE: slow homing gravitational ball (BlackHole flyable) -->
  <item name="black-hole"      icon="black-hole-icon.png"
        model="bowling.spm"    speed="4.0"
        min-height="0.2"       max-height="1.0"
        force-updown="1"       force-to-target="40"
        max-distance="30" />

  <!-- ZIPPER: rocket speed boost -->
  <item name="zipper"          icon="rocket_boost.png" />

  <!-- PHOTON: exchanged photon tether forward / Doppler flare backward -->
  <item name="photon"          icon="photon-icon.png"
        model="plunger.spm"    speed="40"
        min-height="0.2"       max-height="1.0"
        force-updown="35"      force-to-target="15"
        max-distance="30" />

  <!-- SUPER POSITION: boxes and bananas collapse into a 50/50 quantum pickup -->
  <item name="super_position"  icon="super-position-icon.png" />

  <!-- ANTI-KARTICLE: mirrored anti-kart clone with pair-production flash -->
  <item name="anti-karticle"   icon="anti-karticle-icon.png"
        model="bowling.spm"
        speed="0"
        min-height="0.2"       max-height="1.0"
        force-updown="0"       lifetime="10" />

  <!-- WORMHOLE: spawn a linked pair of traversable spacetime shortcuts. -->
  <item name="wormhole"        icon="wormhole-icon.png"
        model="rubber_ball.spm"
        speed="0"
        min-height="0.2"       max-height="1.0"
        force-updown="0"       max-distance="120"
        entry-distance="20"
        exit-distance="100"
        lifetime="20"
        reentry-cooldown="0.5" />

  <!-- TIME-DILATION FIELD: slows other karts (was parachute) -->
  <item name="time-dilation"   icon="time-dilation-icon.png"
        model="parachute.spm" />

  <!-- MAXWELL-BOLTZMANN: random tangent-plane Brownian kicks applied to the leader. -->
  <item name="maxwell-boltzmann" icon="maxwell-boltzmann-powerup-icon.png" />

