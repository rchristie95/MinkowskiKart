// ao.comp
//
// Half-resolution ambient occlusion estimator (Alchemy/SAO, same maths as
// the previous in-pass port of the SP/OpenGL ssao.frag with the track's
// default parameters). The result is blurred by ao_blur.comp and sampled by
// displace_color.frag.

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D u_depth;
layout(binding = 1) uniform sampler2D u_depth2; // unused (shared layout)
layout(binding = 2, r32f) uniform writeonly image2D u_ao_out;

layout(push_constant) uniform Constants
{
    mat4 m_inverse_projection;
    vec4 m_viewport; // full-res camera viewport (x, y, w, h)
    vec4 m_screen;   // full-res screen size
} u_pc;

vec3 viewPosAt(vec2 px)
{
    vec2 ndc = ((px - u_pc.m_viewport.xy) / u_pc.m_viewport.zw) * 2.0 - 1.0;
    float z = texture(u_depth, px / u_pc.m_screen.xy).x;
    vec4 clip = vec4(ndc, z, 1.0);
    vec4 view_pos = u_pc.m_inverse_projection * clip;
    return view_pos.xyz / view_pos.w;
}

float interleavedGradientNoise(highp vec2 w)
{
    const vec3 m = vec3(0.06711056, 0.00583715, 52.9829189);
    return fract(m.z * fract(dot(w, m.xy)));
}

void main()
{
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    ivec2 out_size = imageSize(u_ao_out);
    if (gid.x >= out_size.x || gid.y >= out_size.y)
        return;

    const float RADIUS = 0.5;
    const float K = 3.0;
    const float SIGMA = 1.0;
    const float THICKNESS = 10.0;
    const int SAMPLES = 12;
    const float INV_SAMPLES = 1.0 / float(SAMPLES);

    // Full-res pixel this half-res texel represents
    vec2 px = u_pc.m_viewport.xy + (vec2(gid) + 0.5) * 2.0;

    vec3 frag_pos = viewPosAt(px);
    if (frag_pos.z <= 0.001 || frag_pos.z > 500.0)
    {
        imageStore(u_ao_out, gid, vec4(1.0));
        return;
    }

    // Geometric normal from depth differences (no derivatives in compute)
    vec3 pos_dx = viewPosAt(px + vec2(2.0, 0.0)) - frag_pos;
    vec3 pos_dy = viewPosAt(px + vec2(0.0, 2.0)) - frag_pos;
    vec3 norm = normalize(cross(pos_dy, pos_dx));

    vec2 vp_xy = u_pc.m_viewport.xy;
    vec2 vp_wh = u_pc.m_viewport.zw;

    float r = RADIUS / frag_pos.z;
    float phi = interleavedGradientNoise(px);
    float bl = 0.0;

    float peak = 0.1 * RADIUS;
    float intensity = 2.0 * 3.14159 * SIGMA * peak * INV_SAMPLES;

    float horizon = min(100.0 / min(vp_wh.x, vp_wh.y), 0.3);
    float bias = min(1.0 / min(vp_wh.x, vp_wh.y), 0.003);

    float theta = phi * 2.0 * 2.4 * 3.14159;
    vec2 rotations = vec2(cos(theta), sin(theta)) * vp_wh;
    vec2 offset = vec2(cos(INV_SAMPLES), sin(INV_SAMPLES));

    for (int i = 0; i < SAMPLES; ++i)
    {
        float alpha = (float(i) + 0.5) * INV_SAMPLES;
        rotations = vec2(rotations.x * offset.x - rotations.y * offset.y,
                         rotations.x * offset.y + rotations.y * offset.x);
        float h = r * alpha;
        vec2 occluder_px = clamp(px + h * rotations, vp_xy, vp_xy + vp_wh);
        vec3 occluder_pos = viewPosAt(occluder_px);

        vec3 vi = occluder_pos - frag_pos;
        float vv = dot(vi, vi);
        float vn = dot(vi, norm);
        float w = max(0.0, 1.0 - vv / (THICKNESS * THICKNESS));
        w = w * w;
        w *= step(vv * horizon * horizon, vn * vn);
        bl += w * max(0.0, vn - frag_pos.z * bias) / (vv + peak * peak);
    }

    float ao = pow(max(1.0 - sqrt(bl * intensity), 0.0), K);
    imageStore(u_ao_out, gid, vec4(ao));
}
